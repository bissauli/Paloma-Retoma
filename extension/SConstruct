#!/usr/bin/env python
# Compila la extensión vacía de hilos para la web. Uso (con emsdk activado):
#   scons platform=web target=template_release godot_cpp_path=<ruta a godot-cpp>
import os
env = SConscript(os.path.join(ARGUMENTS.get("godot_cpp_path", "godot-cpp"), "SConstruct"))
env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
library = env.SharedLibrary("../bin/hilos/libhilos{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(library)
